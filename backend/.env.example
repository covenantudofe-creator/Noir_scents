# LOCAL DEVELOPMENT VARIABLES
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
FRONTEND_URL=http://localhost:5173

# Google Identity Services client ID (public) and app-session signing key (private)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_SECRET_KEY=replace-with-a-long-random-secret

# Optional Mailgun order confirmation email settings
MAILGUN_API_KEY=replace-with-a-private-mailgun-api-key
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=Noir Scents <orders@mg.yourdomain.com>
# Use https://api.eu.mailgun.net for an EU Mailgun account
MAILGUN_BASE_URL=https://api.mailgun.net

# RENDER PRODUCTION VARIABLES
# Set these in the backend Web Service's Environment tab, not in a committed file:
# DATABASE_URL=<your existing PostgreSQL connection string>
# FRONTEND_URL=https://<your-render-static-site>.onrender.com
# GOOGLE_CLIENT_ID=<same public Google client ID>
# AUTH_SECRET_KEY=<a unique, strong random secret>
# MAILGUN_API_KEY=<private Mailgun API key>
# MAILGUN_DOMAIN=<verified Mailgun sending domain>
# MAILGUN_FROM=<sender address on that domain>
# MAILGUN_BASE_URL=https://api.mailgun.net
# PORT=<automatically provided by Render>
