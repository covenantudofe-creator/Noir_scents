FRONTEND_URL=http://localhost:5173

# Google OAuth Web client ID and a private random signing key for app sessions
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_SECRET_KEY=replace-with-a-long-random-secret

# Mailgun order confirmation emails (use a verified Mailgun sending domain)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.yourdomain.com
MAILGUN_FROM=Noir Scents <orders@mg.yourdomain.com>
# Use https://api.eu.mailgun.net for an EU Mailgun account
MAILGUN_BASE_URL=https://api.mailgun.net

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback

# Flutterwave
FLW_SECRET_KEY=FLWSECK_TEST-your_key
FLW_SECRET_HASH=your_webhook_secret_hash
FLW_REDIRECT_URL=http://localhost:5173/payment/callback

# Bank transfer - replace with your real business account
BANK_NAME=YOUR BANK NAME
BANK_ACCOUNT_NAME=NOIR_SCENTS
BANK_ACCOUNT_NUMBER=0000000000

# OPay - obtain these from OPay Business Dashboard / Developer Tools
OPAY_CLIENT_AUTH_KEY=
OPAY_HEAD_MERCHANT_ID=
OPAY_MERCHANT_ID=
OPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nPASTE_OPAY_PUBLIC_KEY\n-----END PUBLIC KEY-----"
OPAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
# These are merchant-specific. Confirm the values with OPay before going live.
OPAY_SCENE_ENUM=COLLECTION_SDK
OPAY_SUB_SCENE_ENUM=LOGISTIC
